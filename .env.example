# Public site URL used for canonical links, sitemap.xml, robots.txt, OpenGraph, and JSON-LD schema
NEXT_PUBLIC_SITE_URL="https://usekit.vercel.app"
VITE_SITE_URL="https://usekit.vercel.app"

# Optional AdSense configuration (off by default)
NEXT_PUBLIC_ENABLE_ADS="false"
VITE_ENABLE_ADS="false"
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
VITE_ADSENSE_CLIENT_ID=""

# GEMINI_API_KEY: Required if server-side AI features are enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Runtime service URL injected by hosting environment
APP_URL="https://usekit.vercel.app"
